# Database (PostgreSQL disarankan untuk production, SQLite cukup untuk development lokal)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# URL layanan FastAPI prediksi stok (lihat folder ml-service/)
ML_SERVICE_URL="http://localhost:8000"

# Berapa hari ke depan diproyeksikan secara default
FORECAST_HORIZON_DAYS=14

# Berapa lama (menit) hasil prediksi di-cache sebelum dihitung ulang
FORECAST_CACHE_MINUTES=60
